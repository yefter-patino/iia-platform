# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
aws_region  = "us-east-1"
aws_profile = "default"
name_prefix = "yefter"
environment = "dev"

# /16 gives you room for every later phase. Two /24 public + two /24 private.
vpc_cidr = "10.20.0.0/16"
az_count = 2

# Flip to false and re-apply to kill the NAT Gateway between work sessions.
enable_nat_gateway = true

# Phase 7: the repo allowed to assume the CI role via OIDC.
github_repository = "yefter-patino/iia-platform"
state_bucket_name = "yefter-tfstate-<ACCOUNT_ID>-<REGION>"

# Phase 8: where alarms go. Confirm the SNS subscription email or they vanish.
alert_email = "you@example.com"

# Phase 9: leave empty for a same-account simulation of cross-account access.
partner_account_id = ""
