# --- Terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
tfplan
*.tfplan

# Real values live here. The .example files are what get committed.
*.tfvars
!*.tfvars.example

# One deliberate exception. envs/dev/ci.tfvars holds the values CI plans
# against and contains nothing sensitive: region, CIDR, and the two off
# switches. It is named explicitly rather than by pattern, so a stray
# ci.tfvars elsewhere is still ignored and the blanket *.tfvars rule keeps
# protecting everything else.
!envs/dev/ci.tfvars
backend.hcl
!backend.hcl.example

# --- AWS / secrets ---
.env
*.pem
*.key
credentials
.aws/

# --- Python (Phase 5) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
dist/
build/
*.egg-info/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
